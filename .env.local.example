# ============================================================
# TRIPWISE - ENVIRONMENT VARIABLES (template)
#
# RULE OF THUMB
#   NEXT_PUBLIC_*  -> inlined into the browser bundle (PUBLIC, never a secret)
#   everything else -> SERVER-ONLY, never shipped to the browser
# ============================================================

# SUPABASE CONFIGURATION
# Get these from Supabase Dashboard > Project Settings > API.
#  - SUPABASE_URL has NO public prefix: it is read on the server and bridged to
#    the browser by next.config.mjs (a project URL is an identifier, not a key).
#  - The anon key IS public by design (it ships inside the supabase-js client).
#    Data secrecy comes from Row-Level-Security - see SECURITY.md.
#    NEVER expose a service_role key with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# APPLICATION BASE URL - SERVER-ONLY (used by metadata/robots.txt/sitemap.xml)
APP_URL=http://localhost:3000

# Google Maps API Key - SERVER-ONLY (never expose to the browser).
# Read by the server proxies /api/places/* and /api/routes. Enable Places API
# (New), Routes API and Geocoding API, then restrict the key by API + HTTP
# referrer in Cloud Console.
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Unsplash Access Key - SERVER-ONLY (never expose to the browser).
# Read by the server proxy /api/unsplash. Free key: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# NOTE: NEXT_PUBLIC_GOOGLE_MAPS_API_KEY, NEXT_PUBLIC_UNSPLASH_ACCESS_KEY,
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_APP_URL were removed because they
# leaked secrets into the browser bundle. Do not re-add them.